FROM php:8.3-fpm

RUN apt-get update && apt-get install -y \
    git unzip libpq-dev libicu-dev libzip-dev nginx supervisor \
    && docker-php-ext-install pdo pdo_pgsql pgsql intl zip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /app

COPY . .

RUN mkdir -p config/jwt /var/log/supervisor && \
    if [ ! -f config/jwt/private.pem ]; then \
        openssl genpkey -algorithm RSA -out config/jwt/private.pem -pkeyopt rsa_keygen_bits:2048 && \
        openssl rsa -pubout -in config/jwt/private.pem -out config/jwt/public.pem && \
        chmod 600 config/jwt/private.pem; \
    fi

RUN printf 'APP_ENV=prod\nAPP_SECRET=build_only\nDATABASE_URL=postgresql://dummy:dummy@localhost:5432/dummy\nJWT_SECRET_KEY=%%kernel.project_dir%%/config/jwt/private.pem\nJWT_PUBLIC_KEY=%%kernel.project_dir%%/config/jwt/public.pem\nJWT_PASSPHRASE=\nCORS_ALLOW_ORIGIN=^https?://.*$' > .env && \
    composer install --no-dev --optimize-autoloader --no-interaction && \
    php bin/console cache:clear --env=prod --no-debug --no-interaction

COPY docker/nginx/render.conf /etc/nginx/conf.d/default.conf
COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

RUN rm -f /etc/nginx/sites-enabled/default

RUN chmod +x docker-start.sh

EXPOSE 8080

CMD ./docker-start.sh
