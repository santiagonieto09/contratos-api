# Configuración de la aplicación
APP_ENV=dev
APP_SECRET=cambia_este_secret_en_produccion

# Configuración de la base de datos PostgreSQL
# Para conexión local (fuera de Docker): localhost:5434
# Para conexión dentro de Docker: database:5432
DATABASE_URL=postgresql://contratos_user:contratos_password@database:5432/contratos_db?serverVersion=16&charset=utf8

# Configuración JWT para autenticación
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=contratos_jwt_secret

# Configuración CORS
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
